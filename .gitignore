# Whitelist approach: track the Paper 2 study tree (flattened to root),
# the release checksum manifest, and repo docs. Heavy regenerable data
# (raw per-null records, per-subject caches, release ZIP) stays out.

/*
!/.gitignore
!/LICENSE
!/README.md
!/PROVENANCE.md
!/CITATION.cff
!/requirements.txt
!/run_all.py
!/dist/SHA256SUMS_paper2.txt
!/00_DOCS/
!/01_CONFIG/
!/03_FEATURE_EXTRACTION/
!/04_DEGREE_CONTROL/
!/05_MECHANISM_ANALYSIS/
!/06_NULL_MODELS/
!/07_ROBUSTNESS/
!/08_STATISTICS/
!/09_FIGURES/
!/10_TABLES/
!/11_CASE_STUDIES/
!/12_SYNTHESIS/
!/13_MANUSCRIPT/
!/14_LOGS/
!/15_TESTS/
!/AUDIT/
!/QC/
!/data/
!/results_annotation/
!/scripts_annotation/
!/run_downstream_chain.sh

# Regenerable / heavy artifacts (reproducible from frozen seeds)
06_NULL_MODELS/null_records_checkpoint.jsonl
03_FEATURE_EXTRACTION/_per_subject_cache/
dist/*.zip
__pycache__/
*.pyc
*.tmp
.pytest_cache/

# Secrets / env (defense in depth)
.env
*.pem
*.key
credentials*.json
